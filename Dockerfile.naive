# NAIVE single-stage build — intentionally unoptimized
FROM node:20

WORKDIR /app

# build toolchain + extra utilities, jegulo runtime e lage na
RUN apt-get update && apt-get install -y \
      build-essential python3 git curl vim procps \
    && rm -rf /var/lib/apt/lists/*

# puro source tree copy
COPY . .

# dev dependencies soho sob install
RUN npm install

EXPOSE 3050
# runs as root
CMD ["node", "src/server.js"]